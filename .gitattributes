# Repository text files use LF on every platform.
* text=auto eol=lf

# Binary assets must never be modified by text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.sqlite binary
*.db binary
