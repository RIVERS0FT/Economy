  }

  const scale = methodId === 'high-yield' ? 2 : 1;
  const inputs = baseInputs.map((item) => ({ ...item, quantity: item.quantity * scale }));
  const output = { ...baseOutput, quantity: baseOutput.quantity * scale };
  const cycleMs = methodId === 'high-yield'
    ? recipe.cycleMs
