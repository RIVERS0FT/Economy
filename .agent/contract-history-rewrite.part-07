
update('src/pages/ContractPage.tsx', (content) => replaceOnce(
  content,
  "{showPublish ? <PublishContractPanel model={model} busy={Boolean(busyKey)} close={() => { setShowPublish(false); setRepublishContract(null); }} run={run} initialContract={republishContract} /> : null}",
  "{showPublish ? <PublishContractPanel key={republishContract?.id || 'new'} model={model} busy={Boolean(busyKey)} close={() => { setShowPublish(false); setRepublishContract(null); }} run={run} initialContract={republishContract} /> : null}",
  'remount publish panel for history draft',
));

update('src/styles/contract-audit.css', (content) => replaceOnce(
  content,
  `  .contract-history-republish {
    width: 100%;
  }`,
  `  .contract-history-heading {
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }

  .contract-history-heading .contract-history-republish {
    width: 100%;
    min-width: 0;
    justify-self: stretch;
  }`,
  'mobile republish full-row button',
));

update('tests/browser/contract-layout.spec.ts', (content) => replaceOnce(
  content,
  "  await page.getByRole('button', { name: '重新拟定', exact: true }).click();",
  "  page.once('dialog', (dialog) => dialog.accept());\n  await page.getByRole('button', { name: '重新拟定', exact: true }).click();",
  'accept republish draft replacement confirmation',
));
