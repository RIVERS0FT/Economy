+  }, now + 5), { ok: false, message: '订单参数无效' });
+  assert.deepEqual(applyFacilityGroupAction(world, bob, 'placeOrder', {
+    assetKind: 'facility', assetId: 'farm', side: 'sell', quantity: 1, price: 0.001,
+  }, now + 6), { ok: false, message: '工厂订单参数无效' });
+});
