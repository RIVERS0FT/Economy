  await expect(page.locator('.contract-history-result-grid')).toBeVisible();
  await expect(page.locator('.contract-audit-timeline')).toHaveCount(0);
  const republish = page.getByRole('button', { name: '重新拟定', exact: true });
  const republishBox = await requireBox(republish);
  expect(republishBox.width).toBeGreaterThanOrEqual(250);`,
    'mobile history result assertions',
  );
  return content;
});

write('scripts/verify-contract-audit.mjs', `import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';

function read(path) {
  return readFileSync(new URL(\`../\${path}\`, import.meta.url), 'utf8');
}
function includesAll(content, needles, label) {
  for (const needle of needles) assert.ok(content.includes(needle), \`\${label} must include \${needle}\`);
}

const auditStore = read('server/src/contract-audit-store.js');
const runtimeStore = read('server/src/runtime-store.js');
const app = read('server/src/app.js');
const statePartitions = read('server/src/state-partitions.js');
const contractApi = read('src/contracts/api.ts');
const contractTypes = read('src/contracts/types.ts');
const contractPage = read('src/pages/ContractPage.tsx');
const contractAuditCss = read('src/styles/contract-audit.css');
const serverTests = read('server/test/contract-audit.test.js');
const browserTests = read('tests/browser/contract-layout.spec.ts');
const pageDesign = read('docs/PAGE_CONTENT_AND_NAVIGATION_DESIGN.md');
const industryDesign = read('docs/INDUSTRY_AND_PRODUCTION_DESIGN.md');
const serverDesign = read('docs/SERVER_ARCHITECTURE_AND_DEPLOYMENT_DESIGN.md');
const docsIndex = read('docs/README.md');

includesAll(auditStore, [
  'economy_contract_audit_contracts', 'economy_contract_audit_events', 'economy_contract_audit_transfers',
  'prevent_contract_audit_event_update', 'prevent_contract_audit_event_delete',
  'prevent_contract_audit_transfer_update', 'prevent_contract_audit_transfer_delete',
  'legacy_snapshot_imported', 'audit_completeness', 'source_key TEXT NOT NULL UNIQUE',
  'store.captureContractAuditTransition', 'store.flushContractAuditEvents',
  'store.listContractAuditHistory', 'store.getContractAuditDetail',
  'contractHistorySettlementSummaries', 'endSummary', 'compensationReceivedByMe', 'compensationPaidByMe',
], 'contract audit store');
assert.ok(
  runtimeStore.indexOf('this.updateWorld.run(nextRevision, stateJson, now)')
    < runtimeStore.indexOf('this.flushContractAuditEvents(world, revision, nextRevision)')
    && runtimeStore.indexOf('this.flushContractAuditEvents(world, revision, nextRevision)')
      < runtimeStore.indexOf('this.cacheWorld(nextRevision, stateJson, world)'),
  'audit rows must be flushed after the world write and before the cache advances',
);
includesAll(runtimeStore, ["import { configureContractAuditStore } from './contract-audit-store.js';", 'configureContractAuditStore(this);', 'captureContractAuditTransition(beforeContracts, world'], 'runtime contract audit integration');
includesAll(app, ["path === '/api/game/contracts/history'", 'const contractAuditMatch = path.match(', 'store.listContractAuditHistory', 'store.getContractAuditDetail'], 'contract audit routes');
assert.ok(!statePartitions.includes('contractAudit'));
assert.ok(!statePartitions.includes('contractHistory'));

includesAll(contractApi, ['productionContractAudit', "getJson<{ history: ContractAuditHistoryPage }>('/contracts/history'", 'lender', 'borrower', 'lessor', 'lessee'], 'contract audit client API');
includesAll(contractTypes, ['ContractEndSummary', 'ContractEndSettlementSummary', 'ContractAuditHistoryItem', 'endSummary: ContractEndSummary'], 'contract history client types');
includesAll(contractPage, [
  "import '../styles/contract-audit.css';", '合同历史筛选', '合同内容', '结束原因', '结束时间',
  '完成情况', '结束统计', '重新拟定', 'productionContractAudit.history', 'initialContract',
], 'contract history player UI');
assert.ok(!contractPage.includes('productionContractAudit.detail'), 'player history must not load audit detail timelines');
assert.ok(!contractPage.includes('合同完整审计'), 'player history must not expose the audit viewer');
includesAll(contractAuditCss, ['.contract-history-filters', '.contract-history-result-grid', '.contract-history-section', '.contract-history-republish'], 'contract history result styles');
assert.ok(!contractAuditCss.includes('.contract-audit-timeline'), 'timeline styles must be removed from player UI');

includesAll(serverTests, [
  '合同审计与世界状态在同一事务提交，逐批资产转移可查询且幂等重试不重复',
  '异常结束统计按当前玩家方向返回赔付款', '审计写入失败时世界状态和审计事件一起回滚',
  '上线前已有合同只导入部分完整摘要，不伪造逐批事件', 'append-only', 'legacy_snapshot_imported',
], 'contract audit server tests');
includesAll(browserTests, ['mockContractAudit', '合同内容', '结束统计', '重新拟定', '.contract-history-result-grid'], 'contract history browser tests');
assert.ok(!browserTests.includes("toBeVisible();\\n  await expect(page.locator('.contract-audit-timeline'))"), 'browser tests must not restore visible audit timelines');

for (const [label, content] of [['page design', pageDesign], ['industry design', industryDesign], ['server design', serverDesign], ['document authority index', docsIndex]]) {
  assert.ok(content.includes('合同审计'), \`\${label} must define contract audit rules\`);
}
includesAll(serverDesign, ['economy_contract_audit_contracts', 'economy_contract_audit_events', 'economy_contract_audit_transfers', '/api/game/contracts/history', '/api/game/contracts/:contractId/audit', '终态摘要'], 'server contract audit design');
includesAll(pageDesign, ['单张一级', 'PagePanel', '合同内容、结束原因、结束时间、完成情况、结束统计', '重新拟定', '不加载审计事件时间线'], 'page contract history design');

console.log('Contract audit and compact history verification passed.');
`);

update('scripts/verify-contract-layout.mjs', (content) => {
  content = replaceOnce(
    content,
    "  'contract-history-panel',\n  '自动准备商品',",
    "  'contract-history-panel',\n  'contract-history-result-grid',\n  '重新拟定',\n  '自动准备商品',",
    'contract layout history result checks',
  );
  return replaceOnce(
    content,
    "console.log('合同页四列工作区、常驻合同广场、待处理置顶、双视图切换、响应式布局、历史列表和浏览器回归验证通过。');",
    "console.log('合同页四列工作区、常驻合同广场、待处理置顶、双视图切换、历史结果、重新拟定和响应式浏览器回归验证通过。');",
    'contract layout success message',
  );
});

update('docs/PAGE_CONTENT_AND_NAVIGATION_DESIGN.md', (content) => {
  content = replaceRegex(
    content,
    /合同历史使用右侧区域内的单张一级 `PagePanel`[\s\S]*?不创建页面级弹窗或第二套详情路由。/,
    `合同历史使用右侧区域内的单张一级 \`PagePanel\` 和带分隔线的紧凑记录，不得恢复每条历史记录一张独立玻璃卡片。筛选器固定覆盖合同领域、最终状态、我的角色、合同标的和日期范围，右侧半宽区域使用两列，移动端改为单列；我的角色覆盖采购、供货、放贷、贷款、出租、租赁和原发布者，合同标的覆盖商品、普通货币和工厂类型。

每条历史合同固定展示“合同内容、结束原因、结束时间、完成情况、结束统计”和“重新拟定”按钮。合同内容按商品合作、玩家借贷和工厂租赁分别展示原始发布参数；完成情况按批次、一次性偿还或租金期数展示服务器完成比例；结束原因和结束时间来自服务器终态摘要，客户端不得根据余额或本地时间推断；结束统计按当前玩家视角展示累计货款／租金、服务费、净收入、实际偿还、抵押工厂处置、资金或商品退回，以及非零的“我获得赔付／我支付赔付”。旧合同缺少完整转移事件时显示部分统计提示，不伪造缺失过程。

玩家历史页不展开、不加载审计事件时间线，也不把整条记录做成无明确目标的可点击表面。服务器继续保留追加式事件和资产转移审计及参与者审计接口，用于故障追溯、管理员诊断和未来纠纷核查。点击“重新拟定”后展开页面顶部既有发布合同 \`PagePanel\`，按当前玩家在原合同中的实际角色恢复六类发布方向，并填入相同合同参数；不复制合作方、托管资产、保证金余额、自动操作状态、完成数量、续签关系或结束信息，不得自动发布。若发布面板已有未发布内容，替换前必须确认；标的或参数已不符合当前目录和校验规则时保留可核对值并禁止发布，不得静默替换。`,
    'page contract history rules',
  );
  content = replaceOnce(
    content,
    '合同历史和审计详情必须通过 `GET /api/game/contracts/history` 与 `GET /api/game/contracts/:contractId/audit` 按需加载，只允许参与者查看；不得进入 `EconomyState`、`contract` 分区、分区哈希、导航角标或五秒状态轮询，也不得向玩家返回幂等键、内部来源键、世界修订号或无关资产余额。',
    '合同历史通过 `GET /api/game/contracts/history` 按需加载终态摘要，只允许参与者查看；普通玩家合同页不得请求 `GET /api/game/contracts/:contractId/audit` 或展示事件时间线。审计详情接口和追加式记录继续保留给参与者故障核查、管理员诊断及未来纠纷工具，但不得进入 `EconomyState`、`contract` 分区、分区哈希、导航角标或五秒状态轮询，也不得向玩家返回幂等键、内部来源键、世界修订号或无关资产余额。',
    'page history API boundary',
  );
  content = replaceOnce(
    content,
    '`contract-audit.css` 只负责历史筛选、展开详情、时间线和资产转移明细，不得重新定义按钮、输入、选择器、开关、状态标签或一级卡片外层内边距。历史记录按钮必须接入共享 `data-ui-interactive="surface"` 协议。',
    '`contract-audit.css` 只负责历史筛选、五类结果区、旧数据提示和重新拟定按钮的响应式布局，不得重新定义按钮、输入、选择器、开关、状态标签或一级卡片外层内边距。历史记录主体不是交互表面；重新拟定操作必须复用共享 `Button`。',
    'page contract audit style ownership',
  );
  return content;
});

update('docs/SERVER_ARCHITECTURE_AND_DEPLOYMENT_DESIGN.md', (content) => replaceOnce(
  content,
  '合同动作和世界调度必须在保存世界后的同一个 `BEGIN IMMEDIATE` 事务内写入审计，再更新内存世界缓存；审计插入失败必须回滚世界、修订号、幂等确认和审计。审计事件、资产转移和查询摘要不进入 `economy_world.state_json`。',
  `合同动作和世界调度必须在保存世界后的同一个 \`BEGIN IMMEDIATE\` 事务内写入审计，再更新内存世界缓存；审计插入失败必须回滚世界、修订号、幂等确认和审计。审计事件、资产转移和查询摘要不进入 \`economy_world.state_json\`。

\`GET /api/game/contracts/history\` 必须在一次分页查询中返回合同原始条款与服务器终态摘要。终态摘要固定包含稳定结束原因、权威结束时间、按合同领域表达的完成数量／总量／比例，以及当前玩家视角的结束统计；赔付款必须区分“当前玩家支付”和“当前玩家获得”，不得只返回无方向的总额。商品合作统计累计交付、货款、服务费和净收入；玩家借贷统计本金发放、实际偿还和抵押工厂处置／退回；工厂租赁统计已结算期数、租金、服务费和净收入。资金、商品、保证金和抵押返还只统计实际审计转移，旧合同缺少转移事件时返回部分完整标记并保持缺失项为零。

普通玩家合同页只读取历史终态摘要，不读取审计事件时间线。\`GET /api/game/contracts/:contractId/audit\`、三张追加式审计表和防篡改 Trigger 继续保留，供参与者故障核查、管理员诊断和未来纠纷工具使用；精简玩家界面不得删除、改写或降级这些审计记录。`,
  'server contract terminal summary design',
));

console.log('Contract history result rewrite applied.');
