replaceExact('src/types.ts', '  version: 32;\n', '  version: 33;\n', 1);
for (const name of readdirSync('docs')) {
  if (!name.endsWith('.md')) continue;
  replaceAllIfPresent(join('docs', name), '客户端状态版本：32', '客户端状态版本：33');
  replaceAllIfPresent(join('docs', name), '当前全局基线 32', '当前全局基线 33');
}
replaceAllIfPresent('docs/SERVER_ARCHITECTURE_AND_DEPLOYMENT_DESIGN.md', '当前客户端只接受版本 32', '当前客户端只接受版本 33');
for (const name of readdirSync('scripts')) {
  if (!name.endsWith('.mjs')) continue;
  const path = join('scripts', name);
  replaceAllIfPresent(path, '客户端状态版本：32', '客户端状态版本：33');
  replaceAllIfPresent(path, '当前全局基线 32', '当前全局基线 33');
  replaceAllIfPresent(path, 'CURRENT_CLIENT_STATE_VERSION = 32', 'CURRENT_CLIENT_STATE_VERSION = 33');
  replaceAllIfPresent(path, 'MIN_COMPATIBLE_CLIENT_STATE_VERSION = 32', 'MIN_COMPATIBLE_CLIENT_STATE_VERSION = 33');
  replaceAllIfPresent(path, 'PRODUCTION_CONTRACT_SCHEMA_VERSION = 8', 'PRODUCTION_CONTRACT_SCHEMA_VERSION = 9');
}
replaceExact('scripts/verify-online-auto-sell.mjs', "    'contractAvailableHoldForAutoSell',\n", "    'contractAvailableHoldForAutoSell',\n    'contract?.totalDeliveries === null',\n", 1);
replaceExact('scripts/verify-online-auto-sell.mjs', "    'contractReservations',\n", "    'contractReservations',\n    'contract.totalDeliveries !== null',\n", 1);
replaceExact('scripts/verify-online-auto-sell.mjs', "    '可自动出售 = max(0, available - 生产预定 - 合同可用保留 - 最低自由库存保留量)',\n", "    '可自动出售 = max(0, available - 生产预定 - 合同可用保留 - 最低自由库存保留量)',\n    '长期供货合同始终按仍在履约的下一批计入',\n", 1);
replaceExact('server/test/warehouse.test.js', '    assert.equal(state.version, 32);', '    assert.equal(state.version, 33);', 1);

// Authoritative design rules.
replaceExact(
  'docs/WAREHOUSE_EXPANSION_DESIGN.md',
  '合同可用保留 = Σ(当前玩家作为供应方且启用自动准备的活跃供货合同／已接受续签中，下一批尚未进入 frozen 的缺口)',
  '合同可用保留 = Σ(当前玩家作为供应方且启用自动准备的活跃供货合同／已接受续签中，下一批尚未进入 frozen 的缺口)；长期供货合同始终按仍在履约的下一批计入，不得因 `totalDeliveries = null` 被误判为已完成',
  1,
);
replaceExact(
  'docs/PAGE_CONTENT_AND_NAVIGATION_DESIGN.md',
  '公开商品合作合同支持可选的结构化议价，直接承接始终保留。议价只能修改每批数量、单位价格、交付周期、总批次和首次交付延迟；商品、发布方向和发布者固定，不得加入自由文本、聊天、备注、额外资产或附加条款。',
  '公开商品合作合同支持可选的结构化议价，直接承接始终保留。玩家发布的采购／供应商品合同允许将总批次设置为 2～100 批，或留空形成长期合同；服务器唯一持久化语义为 `totalDeliveries = null`，不得使用超大批次数模拟无限期。长期合同仍只逐批托管下一批商品和货款，不因长期状态冻结未来全部资产；长期合同不会因完成批次数自动结束，也不显示或接受续签，任一参与方申请“完成当前批次后结束”后在该批成功交付时按正常完成计入履约档案。市场储备采购继续使用固定有限批次，不开放长期模式。议价只能修改每批数量、单位价格、交付周期、总批次和首次交付延迟，其中总批次可以在固定批次与长期之间双向修改；商品、发布方向和发布者固定，不得加入自由文本、聊天、备注、额外资产或附加条款。',
  1,
);
replaceExact(
  'docs/PAGE_CONTENT_AND_NAVIGATION_DESIGN.md',
  '发布方向使用两项分段选择器，商品和周期使用 `SelectInput`，每批数量、单位价格和总批次使用 `IntegerInput` 与字符串草稿；空白或非法草稿不得参与预览或提交，失焦后才按统一规则恢复合法值。',
  '发布方向使用两项分段选择器，商品和周期使用 `SelectInput`，每批数量、单位价格和总批次使用 `IntegerInput` 与字符串草稿；每批数量和单位价格的空白或非法草稿不得参与预览或提交并在失焦后按统一规则恢复合法值；总批次是明确的可选整数，空白在失焦后必须保持空白并提交 `null` 表示长期合同，非空时只接受 2～100。预览对长期合同显示“长期”，理论合同总额显示为不可定义，不得用无穷大或虚假总额代替。',
  1,
);
replaceExact(
  'docs/PAGE_CONTENT_AND_NAVIGATION_DESIGN.md',
  '合同剩余三批以内且不在宽限期、未申请结束时显示续签区；商品与合作方固定继承，可调整数量、价格、周期、总批次和首次交付延迟。',
  '仅固定批次合同在剩余三批以内且不在宽限期、未申请结束时显示续签区；长期合同没有到期批次，不显示续签入口。商品与合作方固定继承，可调整数量、价格、周期、总批次和首次交付延迟，续签的新条款允许将总批次留空，从下一份关联合同开始转为长期合同。',
  1,
);
replaceExact(
